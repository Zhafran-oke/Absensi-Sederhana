<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Meneruskan custom HTTP header agar tidak terhapus oleh Apache / FastCGI
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
    SetEnvIf X-Server-Key "(.*)" HTTP_X_SERVER_KEY=$1
    SetEnvIf X-Client-Token "(.*)" HTTP_X_CLIENT_TOKEN=$1
</IfModule>